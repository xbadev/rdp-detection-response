# Default: let Git auto-detect text vs binary, normalize to platform on checkout.
* text=auto

# PowerShell files: keep them as the host platform expects.
# Windows tolerates LF in PS scripts, so LF everywhere is safe and avoids
# the noisy "LF will be replaced by CRLF" warnings on Windows clones.
*.ps1   text eol=lf
*.psm1  text eol=lf
*.psd1  text eol=lf

# Markdown / config: LF preferred (renders identically on both platforms).
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
